{
  "name": "belt-pulley-calculator",
  "private": true,
  "version": "1.0.0",
  "description": "A local belt layout and pulley drive calculator",
  "main": "desktop/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "start": "npm run build && electron .",
    "desktop:shortcut": "npm run build && node desktop/create-shortcut.cjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
